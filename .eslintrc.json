{
  "root": true,
  "env": {
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "globals": {
    "GmailApp": "readonly",
    "SpreadsheetApp": "readonly",
    "PropertiesService": "readonly",
    "CacheService": "readonly",
    "LockService": "readonly",
    "UrlFetchApp": "readonly",
    "Utilities": "readonly",
    "Session": "readonly",
    "ScriptApp": "readonly",
    "HtmlService": "readonly",
    "console": "readonly",
    "CONFIG": "readonly",
    "DAP_COLS": "readonly",
    "DAP_BCI_LOGIC": "readonly",
    "getEnv": "readonly",
    "parseBciDapEmail": "readonly",
    "sendTelegramMessage": "readonly",
    "pushDapToNotion": "readonly",
    "updateNotionDapStatus": "readonly",
    "pingNextPendingDap": "readonly",
    "handleDapConversation": "readonly",
    "finalizeDap": "readonly",
    "forceLiquidateDap": "readonly",
    "_fetchWithRetry": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "node": true,
        "jest": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ],
  "ignorePatterns": ["node_modules/"]
}
